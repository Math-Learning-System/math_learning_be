# Local development — PostgreSQL on localhost (no SSH tunnel)
# Copy to .env.local in this folder (same directory as docker-compose.yml)

SPRING_PROFILES_ACTIVE=local

# Local PostgreSQL (pgAdmin) — run scripts\ps_scripts\setup-local-db.ps1 once
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/math_learning
SPRING_DATASOURCE_USERNAME=math_learning
SPRING_DATASOURCE_PASSWORD=MathLearning@2026

# Do not use SSH tunnel when developing locally
DB_MODE=local

# Redis (Docker: docker compose up -d redis)
REDIS_PASSWORD=12345
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379

# URLs
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8080

# Seed default users on first start (admin / student / teacher)
APP_INIT_ENABLED=true
ADMIN_PASSWORD=Admin@123456
STUDENT_PASSWORD=Student@123456
TEACHER_PASSWORD=Teacher@123456

# JWT (local only — use strong secret in production)
JWT_SIGNERKEY=dev-local-jwt-signer-key-min-32-chars-long!!

# Crawl / AI service
CRAWL_DATA_BASE_URL=http://localhost:8001
CRAWL_DATA_INTERNAL_API_KEY=change-me-in-production

# MinIO (Docker: docker compose up -d minio nginx-minio minio-init)
MINIO_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Optional
FIREBASE_ENABLED=false
GEMINI_API_KEY=
